# ── Robinhood Credentials ────────────────────────────────────────────────────
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password

# TOTP secret from your authenticator app (NOT the 6-digit code).
# Scan the QR code with an app that shows the raw secret, e.g. Aegis / andOTP.
# Leave empty if your account has no MFA.
ROBINHOOD_MFA_SECRET=

# ── Mode ─────────────────────────────────────────────────────────────────────
# Set to "false" to go LIVE.  Default is paper (safe) mode.
PAPER_TRADING=true

# Starting virtual balance for paper trading
PAPER_BALANCE=10000.00

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
