# ── Official MCP API (recommended) ───────────────────────────────────────────
# Bearer token obtained via: claude mcp add robinhood-trading --transport http
#   https://agent.robinhood.com/mcp/trading
# Then authenticate inside a Claude Code session and copy the token here.
MCP_BEARER_TOKEN=

# Your agentic-allowed Robinhood account number (agentic_allowed=true).
# Run get_accounts in Claude Code to find yours.
AGENTIC_ACCOUNT=690935523

# ── robin_stocks fallback (used when MCP_BEARER_TOKEN is empty) ───────────────
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password

# TOTP secret from your authenticator app (NOT the 6-digit code).
ROBINHOOD_MFA_SECRET=

# ── Mode ─────────────────────────────────────────────────────────────────────
# Set to "false" to go LIVE.  Default is paper (safe) mode.
PAPER_TRADING=true

# Starting virtual balance for paper trading
PAPER_BALANCE=10000.00

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
