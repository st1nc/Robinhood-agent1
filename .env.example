# ── Robinhood Credentials ────────────────────────────────────────────────────
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password

# TOTP secret from your authenticator app (NOT the 6-digit code).
# Scan the QR code with an app that shows the raw secret, e.g. Aegis / andOTP.
# Leave empty if your account has no MFA.
ROBINHOOD_MFA_SECRET=

# ── Mode ─────────────────────────────────────────────────────────────────────
# Set to "false" to go LIVE.  Default is paper (safe) mode.
# Shared by both the Robinhood agent and the Solana sniper.
PAPER_TRADING=true

# Starting virtual balance for Robinhood paper trading (USD)
PAPER_BALANCE=10000.00

# ──────────────────────────────────────────────────────────────────────────────
#  Solana Sniper (solana_main.py)
# ──────────────────────────────────────────────────────────────────────────────
# RPC endpoint. The public node is rate-limited; use a paid provider
# (Helius / QuickNode / Triton) for serious sniping.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Base58 secret key of the trading wallet (Phantom: Export Private Key).
# REQUIRED only when PAPER_TRADING=false. NEVER commit a funded wallet key.
WALLET_PRIVATE_KEY=

# Starting virtual balance for Solana paper trading (in SOL)
PAPER_BALANCE_SOL=10.0

# Swap routing
SLIPPAGE_BPS=300                 # 300 = 3% max slippage
PRIORITY_FEE_LAMPORTS=200000     # tip to land the snipe tx

# Discovery / sizing / exits (override defaults from solana_sniper/config.py)
SCAN_INTERVAL_SECONDS=15
MAX_POOL_AGE_MINUTES=30
MIN_LIQUIDITY_USD=5000
MIN_SAFETY_SCORE=4
TRADE_SIZE_SOL=0.25
PROFIT_TARGET_PCT=0.50
STOP_LOSS_PCT=0.25
TRAILING_STOP_PCT=0.20
MAX_HOLD_MINUTES=60
MAX_DAILY_LOSS_SOL=2.0

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
